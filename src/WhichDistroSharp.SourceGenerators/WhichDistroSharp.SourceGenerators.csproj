<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>WhichDistroSharp.SourceGenerators</RootNamespace>
    <PackageId>WhichDistroSharp.SourceGenerators</PackageId>
    <Title>WhichDistroSharp Source Generators</Title>
    <Description>Source generators for WhichDistroSharp.</Description>
    <Authors>Static Codes</Authors>
    <PackageVersion>1.0.0</PackageVersion>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackagePath>analyzers/dotnet/cs</PackagePath>
    <PackageType>Analyzer</PackageType>
    <NoWarn>RS1035</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.10.0" />
  </ItemGroup>

</Project>
